<Window
    x:Class="QuickMacro.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="QuickMacro">
    <controls:NavigationView x:Name="Navigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="False"
        PaneDisplayMode="Left"
        OpenPaneLength="236"
        CompactPaneLength="56"
        SelectionChanged="Navigation_SelectionChanged">
        <controls:NavigationView.PaneHeader>
            <Grid Height="82" Padding="18,15,12,14" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3478F6" Offset="0" />
                            <GradientStop Color="#6B4FE8" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Width="26" Height="26">
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Margin="1,1,4,4" CornerRadius="2" Background="#F2F6FF" />
                        <Border Grid.Column="1" Margin="3,1,1,4" CornerRadius="2" Background="#F2F6FF" Opacity="0.76" />
                        <Border Grid.Row="1" Margin="1,3,4,1" CornerRadius="2" Background="#F2F6FF" Opacity="0.76" />
                        <Border Grid.Row="1" Grid.Column="1" Margin="3,3,1,1" CornerRadius="2" Background="#F2F6FF" />
                        <Path Data="M 17,2 L 10,13 L 14,13 L 10,24 L 20,10 L 15,10 Z" Fill="#FFD166" Stretch="Fill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="QuickMacro" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Shortcuts, made simple" FontSize="11" Opacity="0.65" />
                </StackPanel>
            </Grid>
        </controls:NavigationView.PaneHeader>
        <controls:NavigationView.MenuItems>
            <controls:NavigationViewItem Content="Shortcuts" Tag="shortcuts">
                <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE8D4;" /></controls:NavigationViewItem.Icon>
            </controls:NavigationViewItem>
            <controls:NavigationViewItem Content="Workspaces" Tag="workspaces">
                <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE8A9;" Foreground="#A78BFA" /></controls:NavigationViewItem.Icon>
            </controls:NavigationViewItem>
            <controls:NavigationViewItem Content="Settings" Tag="settings">
                <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" Foreground="#31B8A6" /></controls:NavigationViewItem.Icon>
            </controls:NavigationViewItem>
        </controls:NavigationView.MenuItems>
        <controls:NavigationView.PaneFooter>
            <StackPanel Padding="18,12" Spacing="3">
                <TextBlock Text="QUICKMACRO" FontSize="10" FontWeight="SemiBold" Opacity="0.55" />
                <TextBlock Text="Your apps, one shortcut away." FontSize="11" Opacity="0.7" />
            </StackPanel>
        </controls:NavigationView.PaneFooter>
        <Grid x:Name="PageHost" Padding="26,22,26,20" />
    </controls:NavigationView>
</Window>
